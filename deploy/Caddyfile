# SITE_ADDRESS 是域名（如 learn.example.edu.cn）时，Caddy 会自动申请并续期 HTTPS 证书；
# 是 :80 时只提供 HTTP，适合还没有域名、先在校内按 IP 试用。
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# 上传论文 PDF 最大 30 MB
	request_body {
		max_size 32MB
	}

	reverse_proxy app:8000 {
		# AI 回复是流式的，立即转发每一段
		flush_interval -1
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	# 不开访问日志：请求头里有读文献访问口令，不应写进日志
}
