# 复制成 .env 后填写。.env 已在 .gitignore 里，不要提交，也不要截图外发。

# ---------- 访问地址 ----------
# 有域名：填域名，如 learn.example.edu.cn（先把域名解析到服务器 IP），会自动启用 HTTPS
# 没有域名：保持 :80，用 http://服务器IP 访问
SITE_ADDRESS=:80

# ---------- AI 模型（平台额度） ----------
# DeepSeek 开放平台申请的 API 密钥。留空时平台 AI 导师显示"暂未开通"，学生仍可填自己的密钥。
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
# 每位学生每天的免费消息条数
DAILY_MESSAGE_LIMIT=40

# ---------- 读文献（只给你自己用） ----------
# 访问口令，第一次打开 /papers 时输入。install.sh 会自动生成一个随机口令。留空则关闭读文献模块。
READER_TOKEN=

# ---------- 构建镜像源（国内服务器建议打开） ----------
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
